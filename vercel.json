{
  "functions": {
    "api/index.mjs": {
      "includeFiles": "admin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/admin",
      "destination": "/admin/admin-dashboard.html"
    },
    {
      "source": "/",
      "destination": "/admin/admin-dashboard.html"
    }
  ]
}